# Spotify API Credentials (PKCE flow — no client secret required)
# IMPORTANTE: NO uses comillas ni espacios alrededor de los valores.
#
# Only SPOTIFY_CLIENT_ID is mandatory.
# SPOTIFY_REDIRECT_URI defaults to http://127.0.0.1:8888/callback if not set.

SPOTIFY_CLIENT_ID=your_client_id_here
SPOTIFY_REDIRECT_URI=http://127.0.0.1:8888/callback
